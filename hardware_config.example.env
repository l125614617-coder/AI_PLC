# Simulation defaults. Copy values into your environment; do not commit secrets.
OPENPLC_WEB_BASE=http://127.0.0.1:8081
OPENPLC_MODBUS_HOST=127.0.0.1
OPENPLC_MODBUS_PORT=502
OPENPLC_WEB_USERNAME=openplc
OPENPLC_WEB_PASSWORD=openplc

# Keep disabled for the included virtual-axis scenarios.
PLC_ASSIST_ALLOW_REAL_HARDWARE=0

# A non-loopback target is rejected unless the following is deliberately set
# after the machine-specific I/O map, drive limits, E-Stop chain, and safe
# commissioning procedure have been reviewed:
# PLC_ASSIST_ALLOW_REAL_HARDWARE=1
